            "brand_of",
            "related_to",
            "unknown"
          ]
        },
        "alias_row": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "claim_id",
        "passage_id",
        "mention_text",
        "entity_id",
        "link_status",
        "match_method",
        "mapping_kind",
        "alias_row",
        "reason"
      ],
      "additionalProperties": false
    }
  }
